<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>LiveEditor</RootNamespace>
    <AssemblyName>LiveEditor</AssemblyName>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateSupportedOSPlatformAttribute>false</GenerateSupportedOSPlatformAttribute>
    <GenerateTargetPlatformAttribute>false</GenerateTargetPlatformAttribute>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <LangVersion>latest</LangVersion>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AnalysisLevel>none</AnalysisLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <ProjectReference Include="..\MDConverter\MDConverter.csproj" />
    <ProjectReference Include="..\MermaidRecognition\MermaidRecognition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="AzureResourceGraphConnectionForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="AzureResourceGraphConnectionForm.Designer.cs">
      <DependentUpon>AzureResourceGraphConnectionForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="AzureResourceGraphConnectionForm.resx">
      <DependentUpon>AzureResourceGraphConnectionForm.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="AzureResourceGraphImportForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="AzureResourceGraphImportForm.Designer.cs">
      <DependentUpon>AzureResourceGraphImportForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="AzureResourceGraphImportForm.resx">
      <DependentUpon>AzureResourceGraphImportForm.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

</Project>
