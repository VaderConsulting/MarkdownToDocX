<Project Sdk="Microsoft.NET.Sdk">



  <PropertyGroup>

    <TargetFramework>net10.0</TargetFramework>

    <RootNamespace>MermaidRecognition.Layout</RootNamespace>

    <AssemblyName>MermaidRecognition.Layout</AssemblyName>

    <LangVersion>latest</LangVersion>

    <ImplicitUsings>disable</ImplicitUsings>

    <Nullable>enable</Nullable>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <NoWarn>$(NoWarn);CS1591;CS0618;CS0168;CS0219;CS0414;CS0649;CS0162;CS0612;CS8981;SYSLIB0011;CS8600;CS8602;CS8603;CS8604;CS8618;CS8625;CS8765</NoWarn>

    <DefineConstants>$(DefineConstants);TRACE;NET4;PARALLEL_SUPPORTED;PARALLEL35;TEST_MSAGL;REPORTING;PERSISTENCE</DefineConstants>

    <Description>DiagramContract to adopted Sugiyama layout (Stage 11.B–C).</Description>

    <Version>0.1.0</Version>

    <Authors>MarkdownToDocX</Authors>

    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <AnalysisLevel>none</AnalysisLevel>

  </PropertyGroup>



  <ItemGroup>

    <ProjectReference Include="..\MermaidRecognition\MermaidRecognition.csproj" />

    <PackageReference Include="Msagl" Version="1.2.1" />

  </ItemGroup>



  <ItemGroup>

    <EmbeddedResource Update="Sugiyama\Strings.resx">

      <Generator>ResXFileCodeGenerator</Generator>

    </EmbeddedResource>

  </ItemGroup>



</Project>


