<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MermaidRecognition.Layout.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AnalysisLevel>none</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\MermaidRecognition.Tests\FlowchartRecognition\*.mmd" CopyToOutputDirectory="PreserveNewest" Link="FlowchartRecognition\%(Filename)%(Extension)" />
    <None Include="RoutingIntent\**\*" CopyToOutputDirectory="PreserveNewest" Link="RoutingIntent\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="EnterpriseFlowchartSamples\*.mmd" CopyToOutputDirectory="PreserveNewest" Link="EnterpriseFlowchartSamples\%(Filename)%(Extension)" />
    <None Include="QualityGateFixtures\*" CopyToOutputDirectory="PreserveNewest" Link="QualityGateFixtures\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <ProjectReference Include="..\..\src\MermaidRecognition.Layout\MermaidRecognition.Layout.csproj" />
    <ProjectReference Include="..\..\src\MermaidRecognition\MermaidRecognition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\ProductionCatalogueTestFixture.cs" Link="ProductionCatalogueTestFixture.cs" />
    <Compile Include="..\CatalogueScenarioPolicy.cs" Link="CatalogueScenarioPolicy.cs" />
    <None Include="..\CatalogueScenarioPolicy.json" Link="CatalogueScenarioPolicy.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
