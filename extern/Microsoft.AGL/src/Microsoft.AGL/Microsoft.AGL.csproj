<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Microsoft.AGL</RootNamespace>
    <AssemblyName>Microsoft.AGL</AssemblyName>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <SignAssembly>false</SignAssembly>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AnalysisLevel>none</AnalysisLevel>
    <NoWarn>$(NoWarn);CS1591;CS0618;CS0168;CS0219;CS0414;CS0649;CS0162;CS0612;CS8981;SYSLIB0011</NoWarn>
    <DefineConstants>$(DefineConstants);TRACE;NET4;PARALLEL_SUPPORTED;PARALLEL35;TEST_MSAGL;REPORTING;PERSISTENCE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Properties\AssemblyInfo.cs" />
  </ItemGroup>

</Project>
