{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rules.schema.json",
  "title": "Layout and routing rules (rules.yaml)",
  "description": "Schema for docs/Instructions/rules.yaml, the single source of the layout and routing rules. LAYOUT-RULEBOOK.md is generated from it by Build-Rulebook.ps1. rules.yaml is written in a strict YAML subset described in its header comments.",
  "type": "object",
  "required": ["version", "generated_from", "sections", "terms", "parameters", "precedence", "rules", "entries"],
  "properties": {
    "version": { "type": "string" },
    "generated_from": { "type": "string" },
    "built": { "type": "string" },
    "render_file": { "type": "string" },
    "line_ending": { "enum": ["CRLF", "LF"] },
    "sections": { "type": "array", "items": { "type": "object", "required": ["id", "order", "blank_before", "heading"],
      "properties": { "id": { "type": "string" }, "order": { "type": "integer" }, "blank_before": { "type": "integer", "minimum": 0 }, "heading": { "type": "string" } } } },
    "terms": { "type": "array", "items": { "type": "object", "required": ["id", "name", "text", "order", "blank_before"],
      "properties": { "id": { "type": "string", "pattern": "^term\\." }, "name": { "type": "string" }, "qualifier": { "type": "string" }, "section": { "type": "string" },
        "order": { "type": "integer" }, "blank_before": { "type": "integer", "minimum": 0 }, "text": { "type": "string" } } } },
    "parameters": { "type": "array", "items": { "type": "object", "required": ["id", "value", "unit", "used_by"],
      "properties": { "id": { "type": "string" }, "value": { "type": "number" }, "unit": { "type": "string" }, "source": { "type": "string" },
        "used_by": { "type": "array", "items": { "type": "string" } } } } },
    "precedence": { "type": "array", "items": { "type": "object", "required": ["id", "group", "name", "rules"],
      "properties": { "id": { "type": "string" }, "group": { "enum": ["grid", "placement", "routing", "repair", "labels-frames", "legality"] }, "name": { "type": "string" },
        "rules": { "type": "array", "items": { "type": "string" } } } } },
    "rules": { "type": "array", "items": { "type": "object",
      "required": ["id", "title", "section", "kind", "stage", "status", "text", "order", "blank_before"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "title": { "type": "string" }, "title_in_text": { "type": "boolean" },
        "section": { "type": "string" },
        "kind": { "enum": ["legality", "routing-fault", "quality", "structure/pointer", "removed"] },
        "stage": { "type": "string" },
        "status": { "enum": ["active", "removed"] },
        "pointer": { "type": "string" },
        "params": { "type": "array", "items": { "type": "string" } },
        "refs": { "type": "array", "items": { "type": "string" } },
        "outranks": { "type": "array", "items": { "type": "string" } },
        "yields": { "type": "array", "items": { "type": "string" } },
        "pictures": { "type": "array", "items": { "type": "string" } },
        "hint_overridable": { "type": "boolean" },
        "order": { "type": "integer" }, "blank_before": { "type": "integer", "minimum": 0 },
        "text": { "type": "string", "description": "Exact rulebook wording after the rule number; continuation bullet lines included verbatim." } } } },
    "entries": { "type": "array", "items": { "type": "object", "required": ["id", "kind", "section", "text", "order", "blank_before"],
      "properties": { "id": { "type": "string" }, "kind": { "enum": ["preamble", "legality", "routing-fault", "on-hold", "resolved-conflict"] },
        "section": { "type": "string" }, "refs": { "type": "array", "items": { "type": "string" } }, "pictures": { "type": "array", "items": { "type": "string" } },
        "order": { "type": "integer" }, "blank_before": { "type": "integer", "minimum": 0 }, "text": { "type": "string" } } } }
  }
}
